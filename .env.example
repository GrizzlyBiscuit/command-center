# Example secrets file - copy to .env and fill in real values
# Never commit .env to version control

# Hub
FLASK_PORT=5050

# Optional desktop launcher overrides (blank values use portable defaults)
HUB_URL=
CC_HUB_SCRIPT=
CC_HUB_PYTHON=
CC_LAUNCHER_RUNTIME_DIR=
CC_HUB_LOG_FILE=
CC_LAUNCHER_LOCK_FILE=
CC_HUB_PID_FILE=
CC_LAUNCHER_LIFETIME_FILE=
# CC_LAUNCHER_PYTHON is read by launch_cc.vbs from the Windows environment

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: blank auto-detects PATH or the current Windows user's standard install
OLLAMA_EXE=

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional relay / platform tokens
RELAY_SCRIPT=
RELAY_LAUNCHER=
RELAY_VENV_PY=
RELAY_PIDFILE=
RELAY_LOGFILE=
